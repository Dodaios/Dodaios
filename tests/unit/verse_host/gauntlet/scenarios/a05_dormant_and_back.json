{
  "name": "a05_dormant_and_back",
  "description": "A-05: hide goes Dormant within 1 s; show is Visible again within 300 ms.",
  "topics": [],
  "watch_screens": [],
  "watch_chat_tails": [],
  "state": {},
  "replies": {},
  "steps": [
    {
      "at_ms": 200,
      "frame": {
        "type": "lifecycle.show",
        "data": {
          "monitor": {
            "x": 0,
            "y": 0,
            "w": 1280,
            "h": 720,
            "dpi": 1.0
          },
          "reason": "verse_view"
        }
      }
    },
    {
      "at_ms": 200,
      "expect": {
        "type": "lifecycle.state",
        "data": {
          "state": "visible"
        }
      },
      "timeout_ms": 60000
    },
    {
      "at_ms": 2000,
      "frame": {
        "type": "lifecycle.hide",
        "data": {
          "reason": "app_focus"
        }
      }
    },
    {
      "at_ms": 2000,
      "expect": {
        "type": "lifecycle.state",
        "data": {
          "state": "dormant"
        }
      },
      "timeout_ms": 1000
    },
    {
      "at_ms": 4000,
      "frame": {
        "type": "lifecycle.show",
        "data": {
          "monitor": {
            "x": 0,
            "y": 0,
            "w": 1280,
            "h": 720,
            "dpi": 1.0
          },
          "reason": "verse_view"
        }
      }
    },
    {
      "at_ms": 4000,
      "expect": {
        "type": "lifecycle.state",
        "data": {
          "state": "visible"
        }
      },
      "timeout_ms": 300
    },
    {
      "at_ms": 4000,
      "frame": {
        "type": "lifecycle.quit",
        "data": {
          "reason": "app_quit",
          "deadline_ms": 3000
        }
      }
    },
    {
      "at_ms": 4000,
      "expect": {
        "type": "lifecycle.bye"
      },
      "timeout_ms": 5000
    }
  ]
}
