          "reason": "app_focus"
        }
      }
    },
    {
      "at_ms": 3000,
      "expect": {
        "type": "lifecycle.state",
        "data": {
          "state": "dormant"
        }
      },
      "timeout_ms": 3000
    },
    {
      "at_ms": 5000,
      "frame": {
        "type": "lifecycle.show",
        "data": {
          "monitor": {
            "x": 0,
            "y": 0,
            "w": 1280,
            "h": 720,
            "dpi": 1.0
          },
          "reason": "verse_view"
        }
      }
    },
    {
