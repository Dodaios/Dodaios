<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/hud_cyan_dim" />
            <stroke android:width="1dp" android:color="@color/hud_cyan" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/hud_panel" />
            <stroke android:width="1dp" android:color="@color/hud_cyan_dim" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/hud_panel_hi" />
            <stroke android:width="1dp" android:color="@color/hud_cyan" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
