    {"at_ms": 600, "frame": {"type": "panel.resize", "data": {"w": 560, "h": 360, "dpr": 1.5}}},
    {"at_ms": 900, "frame": {"type": "panel.resize", "data": {"w": 560, "h": 360, "dpr": 2.0}}},
    {"at_ms": 1200, "frame": {"type": "panel.visibility", "data": {"visible": false, "w": 0, "h": 0, "dpr": 2.0}}},
    {"at_ms": 1200, "expect": {"type": "panel.stream_state", "data": {"state": "stopped"}}, "timeout_ms": 1000}
