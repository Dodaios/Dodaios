    "idle": { "beacon": "none", "colour": "#6b6e72", "on_duty": false, "pulse_s": 0.0 },
    "paused": { "beacon": "none", "colour": "#4a4c50", "on_duty": false, "pulse_s": 0.0 },
    "error": { "beacon": "slow_pulse", "colour": "#c8321e", "on_duty": true, "pulse_s": 1.6 }
  }
