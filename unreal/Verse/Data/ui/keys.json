    { "action": "move_back", "key": "S", "label": "verse.key.move_back" },
    { "action": "move_left", "key": "A", "label": "verse.key.move_left" },
    { "action": "move_right", "key": "D", "label": "verse.key.move_right" },
    { "action": "sprint", "key": "LeftShift", "label": "verse.key.sprint" },
    { "action": "crouch", "key": "LeftControl", "label": "verse.key.crouch" },
    { "action": "prone", "key": "Z", "label": "verse.key.prone" },
    { "action": "jump", "key": "SpaceBar", "label": "verse.key.jump" },
    { "action": "lean_left", "key": "Q", "label": "verse.key.lean_left" },
    { "action": "lean_right", "key": "E", "label": "verse.key.lean_right" },
    { "action": "fire", "key": "LeftMouseButton", "label": "verse.key.fire" },
    { "action": "ads", "key": "RightMouseButton", "label": "verse.key.ads" },
    { "action": "reload", "key": "R", "label": "verse.key.reload" },
