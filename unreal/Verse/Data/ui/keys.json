    { "action": "slot_melee", "key": "Three", "label": "verse.key.slot_melee" },
    { "action": "interact", "key": "F", "label": "verse.key.interact" },
    { "action": "verse_bar", "key": "Tab", "label": "verse.key.verse_bar", "ui": "verse_bar" },
    { "action": "skip_kill_cam", "key": "Enter", "label": "verse.key.skip_kill_cam", "ui": "skip_kill_cam" },
    { "action": "return_to_app", "key": "F10", "label": "verse.key.return_to_app", "ui": "return_to_app" }
